# Meridian v2 — environment variables
# Copy to .env and fill in values. Never commit .env.

VOYAGE_API_KEY=         # Embeddings — voyage-4-large via Qdrant
                        # from dash.voyageai.com

QDRANT_URL=             # Vector store
                        # https://your-cluster.cloud.qdrant.io (Qdrant Cloud)
                        # or http://localhost:6333 (local Docker)

QDRANT_API_KEY=         # Qdrant Cloud only — leave blank for local Docker

DEEPSEEK_API_KEY=       # LLM calls — Phase 3 (query understanding)
                        # and Phase 8 (synthesis)
                        # from platform.deepseek.com
                        # Models: deepseek-v4-pro (heavy), deepseek-v4-flash (fast)

LANGFUSE_PUBLIC_KEY=    # Tracing — not wired yet, placeholder
LANGFUSE_SECRET_KEY=    # Tracing — not wired yet, placeholder
LANGFUSE_BASE_URL=

OPENAI_API_KEY=         # Not used in v2 production pipeline
                        # Retained for MAUD title generation (one-time script)
                        # and paper replication baseline only

PHOENIX_ENABLED=        # Set to 1 to enable local Phoenix tracing.
                        # Run phoenix server first:
                        # python -m phoenix.server.main serve
                        # UI at http://localhost:6006
