# Meridian — environment variables
# Copy to .env and fill in values. Never commit .env.

VOYAGE_API_KEY=        # from dash.voyageai.com
QDRANT_URL=            # https://your-cluster.cloud.qdrant.io
                       # (Qdrant Cloud free tier at cloud.qdrant.io)
                       # or http://localhost:6333 for local Docker
QDRANT_API_KEY=        # from Qdrant Cloud dashboard → API Keys
                       # leave blank for local Docker (no auth needed)
OPENAI_API_KEY=        # needed for: MAUD title generation (one-time),
                       # --replicate flag (paper replication baseline)
                       # not used in production experiments
LANGFUSE_PUBLIC_KEY=   # Phase 3 — not needed yet
LANGFUSE_SECRET_KEY=   # Phase 3 — not needed yet
DEEPSEEK_API_KEY=      # Phase 3 — not needed yet
